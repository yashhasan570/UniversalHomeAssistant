FROM python:3.14.10-alpine

ENV \
    UV_SYSTEM_PYTHON=true \
    UV_EXTRA_INDEX_URL="https://wheels.universalassistant.io/musllinux-index/"

SHELL ["/bin/sh", "-o", "pipefail", "-c"]
ENTRYPOINT ["/usr/src/universalassistant/script/hassfest/docker/entrypoint.sh"]
WORKDIR "/github/workspace"

COPY --parents pyproject.toml requirements.txt requirements_all.txt universalassistant/ script packages/hassfest /usr/src/universalassistant/

# Uv creates a lock file in /tmp
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=requirements_test.txt,target=/tmp/requirements_test.txt,readonly \
    --mount=type=bind,source=requirements_test_pre_commit.txt,target=/tmp/requirements_test_pre_commit.txt,readonly \
    # Required for PyTurboJPEG
    apk add --no-cache libturbojpeg \
    # Install uv at the version pinned in the requirements file
    && pip install --no-cache-dir "uv==$(awk -F'==' '/^uv==/{print $2}' /usr/src/universalassistant/requirements.txt)" \
    # Install CI-only tooling from PyPI, bypassing the __HA_KEEP__ wheel index
    && UV_EXTRA_INDEX_URL="" uv pip install \
        --no-build \
        --no-cache \
        "pipdeptree==$(awk -F'==' '/^pipdeptree==/{print $2}' /tmp/requirements_test.txt)" \
        "tqdm==$(awk -F'==' '/^tqdm==/{print $2}' /tmp/requirements_test.txt)" \
        "ruff==$(awk -F'==' '/^ruff==/{print $2}' /tmp/requirements_test_pre_commit.txt)" \
    && uv pip install \
        --no-build \
        --no-cache \
        -c /usr/src/universalassistant/universalassistant/package_constraints.txt \
        -r /usr/src/universalassistant/requirements.txt \
    && UV_EXTRA_INDEX_URL="" uv pip install \
        --no-cache \
        --no-deps \
        --config-settings editable_mode=compat \
        -e /usr/src/universalassistant/packages/hassfest

